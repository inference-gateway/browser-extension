{
  "manifest_version": 3,
  "name": "Inference Gateway - GitHub Comment Helper",
  "description": "Repo-skill tab-completion and quick-prompts in GitHub issue/PR comments.",
  "version": "0.1.0",
  "permissions": ["storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
